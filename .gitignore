# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# 数据（本地生成，不入库）
# *.db-* 覆盖 SQLite WAL 模式的边车文件 .db-wal / .db-shm / .db-journal
backend/data/*.db
backend/data/*.db-*
*.log

# 前端
node_modules/
frontend/dist/
frontend/.vite/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 部署产物。**必须排除**：包里含 .env（iFinD 密钥、飞书 webhook 地址）
# 和一份数据库快照，提交上去等于把密钥和持仓笔记一起公开。
dist-deploy/

# 环境变量
.env
.env.local

# Trae 工作区 MCP 配置。**必须排除**：它虽由 Trae 保护（模型改不了），
# 但里面硬编码了 iFinD 的 Authorization token —— 一旦被 `git add .` 带上去，
# 等于把密钥公开（本仓库是公开的）。
.trae/mcp.json

# 本机留档、不入库的文档：Trae 生成的规划稿，与同花顺公式目录下那份
# 3.5 MB 的建站全过程记录（逐轮排查 / 对话式流水，公开仓库里既占体积也没读者）。
.trae/documents/
同花顺公式/搭建每日复盘选股网站.md

# 一键部署脚本（含服务器 SSH 密码，绝不能提交）
push.ps1

# 部署验证的一次性脚本。同名的 .ps1 里同样硬编码了服务器密码，
# 且这两个文件是一次性排查用的，没有入库价值。
_deploy_check.*

# 公开仓库的一份**旧克隆**（嵌套在自己的工作区里，带独立的 .git）。
# 它含未脱敏的服务器 IP / 备案数据码 / 邮箱，绝不能提交；
# 也不该作为工作区的一部分（避免 `git add .` 时被当成嵌入仓库加进去）。
zhifujing/
