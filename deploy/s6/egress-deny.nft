#!/usr/sbin/nft -f
# S6.1 出站默认拒绝（Linux / nftables）—— **仅专用隔离 VM/namespace**
#
# 目标：应用 uid（默认 fupan）不能直接访问公网，只能：
#   - 访问本机受控 egress proxy（127.0.0.1:3128）；
#   - 访问本机后端端口（127.0.0.1:8000，同机健康检查/内部调用）；
#   - 向指定 resolver（127.0.0.53:53，systemd-resolved）发 DNS。
# 其余一律 drop 并计数。
#
# ⚠️ 不要把整段 loopback 放行：那会让应用连到任意本机代理端口（如 7890）
#    再由代理进程出网，形成绕过。这里 loopback 只精确放行端口。
#
# 不修改主机既有规则：本文件只创建独立表 inet s6_egress，删除该表即回滚。
table inet s6_egress {
    chain output {
        type filter hook output priority 0; policy accept;

        # 1) 只处理应用 uid；其它进程不受本表影响
        meta skuid != "fupan" return

        # 2) loopback：只放行受控端口（proxy / 本机后端）
        ip daddr 127.0.0.1 tcp dport { 3128, 8000 } accept
        ip6 daddr ::1 tcp dport { 3128, 8000 } accept

        # 3) 指定 resolver（systemd-resolved stub）；其它 DNS 目标一律拒绝
        ip daddr 127.0.0.53 udp dport 53 accept
        ip daddr 127.0.0.53 tcp dport 53 accept
        ip6 daddr ::1 udp dport 53 accept
        ip6 daddr ::1 tcp dport 53 accept

        # 4) 其余（IPv4/IPv6、TCP/UDP、任意端口）默认拒绝并计数
        counter drop
    }

    # 防御性重复：即使其它表在更高优先级放行，这里再拦一次
    chain output_deny {
        type filter hook output priority 10; policy accept;
        meta skuid != "fupan" return
        ip daddr 127.0.0.1 tcp dport { 3128, 8000 } accept
        ip6 daddr ::1 tcp dport { 3128, 8000 } accept
        ip daddr 127.0.0.53 udp dport 53 accept
        ip daddr 127.0.0.53 tcp dport 53 accept
        ip6 daddr ::1 udp dport 53 accept
        ip6 daddr ::1 tcp dport 53 accept
        counter drop
    }
}
